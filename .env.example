# Free option (default): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
WEBPILOT_PROVIDER=gemini
# WEBPILOT_MODEL=gemini-2.5-flash

# Paid option:
# ANTHROPIC_API_KEY=your-key-here
# WEBPILOT_PROVIDER=anthropic

WEBPILOT_MAX_STEPS=40
WEBPILOT_MAX_RETRIES=2
WEBPILOT_HEADLESS=true
